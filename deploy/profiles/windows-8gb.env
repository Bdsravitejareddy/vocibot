# VociBot Enterprise - Windows PC, 8 GB RAM, CPU only. Comparison profile:
# smaller note model (qwen2.5 3B) with noticeably weaker notes.
# Measured footprint: speech ~1.4 GB + note model ~2.3 GB = ~3.7 GB.
AI_MODE=local
STT_PROVIDER=whisper
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL=small
FINAL_WHISPER_MODEL=
ASR_CPU_THREADS=4
MAX_LIVE_SESSIONS=1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MAX_CONTEXT=6144
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_GPU=-1
OLLAMA_TIMEOUT_SECONDS=900
