# VociBot Enterprise - Windows PC, 16 GB RAM (DDR4), CPU (an NVIDIA GPU is used
# automatically by Ollama for the note model when present).
# Measured footprint: speech ~3.0 GB + note model ~5.3 GB = ~8.3 GB.
AI_MODE=local
STT_PROVIDER=whisper
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Live preview: fast. Final transcript after Stop: accurate.
WHISPER_MODEL=small
FINAL_WHISPER_MODEL=large-v3-turbo
# Set to the number of physical CPU cores.
ASR_CPU_THREADS=4
# Two live previews at once keep live text ~2-4 s behind on a 4-core CPU;
# further sessions are recorded and transcribed after Stop.
MAX_LIVE_SESSIONS=2
OLLAMA_MODEL=llama3.1:8b
OLLAMA_MAX_CONTEXT=12288
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_GPU=-1
OLLAMA_TIMEOUT_SECONDS=900
